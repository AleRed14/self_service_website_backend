{
  "compilerOptions": {
    
    "target": "ES2022",                                  
    "module": "NodeNext",                                
    "moduleResolution": "NodeNext",                      
    "lib": [
      "ES2022",
      "DOM",
      "dom.iterable"
    ],                               
    
    
    "outDir": "./dist",                                  
    "rootDir": "./src",                                  
    "baseUrl": ".",                                     
    
    
    "typeRoots": [
      "./node_modules/@types", 
      "./src/@types"                                         
    ],

    
    "esModuleInterop": true,                             
    "forceConsistentCasingInFileNames": true,            
    "strict": true,                                      
    "skipLibCheck": true,                                
    "resolveJsonModule": true                            
  },
  "include": [
    "src/**/*",                                         
    "@types/**/*"                                   
  ],
  "exclude": [
    "node_modules",                                      
    "dist"                                          
  ]
}