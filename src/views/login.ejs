<%- include("partials/head.ejs") %>
<%- include("partials/nav.ejs") %>

<main>
    <div id="login-container" class="crudForm-container">

        <!-- Amosamos o mensaxe de error do endpoint -->
        <% if (typeof error !== "undefined") { %>
            <div class="error-message">
                <%= error %>
            </div>
        <% } %> 
        
        <!-- Ahora los datos no los enviamos con fetch, sino con <form> -> Necesitamos parsear nuestros datos (no json) en nuestra aplicacion -->
        <form id="login-fomr" action="/login" method="post" autocomplete="off">

            <label for="emailUser">Email</label>
            <input type="email" name="email" id="emailUser" required>

            <label for="passwordUser">Password</label>
            <input type="password" name="password" id="passwordUser" required>

            <input type="submit" class="btn-login" value="login">
            <input type="button" id="acceso" class="btn-login" value="Acceso rapido">
        </form>

        <!-- Enviando una peticion POST con <form> 
        - Express no sabe como leer el cuerpo de la peticion POST si no tienes un middleware parsing.
        
        - En el caso de un formulario HTML clasico (method="POST"), el navegador envia los datos como aplications/x-www-form-urlencoded por defecto.
        
        - Si no tiene el parser de urlencoded, req.body sera undefined.
        Envia datos como 'aplication/x-www-form-urlencoded' -> necesita 'express.urlencoded'.-->
    </div>
</main>

<script>
    let emailUser = document.getElementById("emailUser");
    let passwordUser = document.getElementById("passwordUser");

    let acceso_rapido = document.getElementById("acceso");

    acceso_rapido.addEventListener("click", () => {
        emailUser.value = "test@test.com";
        passwordUser.value = "test";
    });
</script>

